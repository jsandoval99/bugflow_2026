# ---- BUILD STAGE ----
FROM node:22-alpine AS builder

WORKDIR /app

# ---- FORCE NPM 11 STAGE ----
RUN npm install -g npm@11.12.0

COPY . .

RUN npm ci

RUN npx nx build api --configuration=production

# ---- RUNTIME STAGE ----
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

# ---- KEEP NPM 11 STAGE ----
RUN npm install -g npm@11.12.0

COPY package*.json ./

RUN npm ci

COPY --from=builder /app/dist/api ./

EXPOSE 3000

CMD ["node", "main.js"]